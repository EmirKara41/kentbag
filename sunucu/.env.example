# Vercel Marketplace > Neon > Connect (pooled PostgreSQL URL)
DATABASE_URL=
# Fixed production URL, e.g. https://kentyanimda-api.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Vercel Storage > Blob > PRIVATE store > Connect
BLOB_READ_WRITE_TOKEN=
# Exact comma-separated web preview origins, no wildcard. Android https://localhost is included by the server.
WEB_ORIGINS=http://localhost:4173,http://localhost:8082
